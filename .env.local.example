# Copy this file to .env.local and fill the values (DO NOT commit real secrets)
# Required for the app to connect to Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (required for server-side operations that bypass RLS,
# e.g. deleting rows from the admin panel). Keep this secret and do NOT commit it.
SUPABASE_SERVICE_ROLE=

# Optional: storage bucket name used by the app
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=galeri
# Copy this file to .env.local and fill with your Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-anon-key

# Optional (do NOT commit service role to public repos):
# SUPABASE_SERVICE_ROLE=your-service-role-key
